# =====================================================================
# SERENO · variables de entorno
#
# Copia este archivo a .env.local y rellena los valores. .env.local esta en
# .gitignore: LAS LLAVES NO SE SUBEN AL REPO.
#
# El backend funciona SIN Supabase: los endpoints de clima, prevencion, mercado
# e historico corren contra las APIs publicas y no necesitan base de datos. Solo
# guardar parcelas, reportes y avisos necesita estas dos ultimas variables.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Llave publica (anon). Puede ir al navegador: RLS la limita a lo del usuario.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave de servicio. SOLO SERVIDOR. Salta RLS. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Coordenada de demo ----------------------------------------------
# SERENO-investigacion.md §4 advierte: elegir un punto entre 900 y 1400 m.
# Con el punto de Huehuetenango a 1905 m la celda sale fria, W(T) se infla y el
# demo se ve pobre. Verificar la altura con /api/fuentes?lat=..&lon=..&probar=1
# Verificado hoy con la API: 14.50,-91.15 devuelve 912 m. De 25 coordenadas
# probadas en el altiplano y el piedemonte, fue la unica que cayo en el rango.
SERENO_DEMO_LAT=14.50
SERENO_DEMO_LON=-91.15

# --- Nada mas hace falta ---------------------------------------------
# Las seis fuentes de datos NO requieren llave:
#   Open-Meteo, MET Norway, GDELT, NASA POWER, Anacafe, CKAN del MAGA.
# met.no si exige un User-Agent identificable; esta en el codigo
# (src/lib/fuentes/base.ts) y es la URL publica del repo, sin datos personales.
